{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": false,
  "separate-pull-requests": false,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Bug Fixes" },
    { "type": "revert", "section": "Bug Fixes" },
    { "type": "style", "section": "Miscellaneous" },
    { "type": "refactor", "section": "Miscellaneous" },
    { "type": "build", "section": "Miscellaneous" },
    { "type": "docs", "section": "Miscellaneous" },
    { "type": "ci", "section": "Miscellaneous", "hidden": true },
    { "type": "test", "section": "Miscellaneous", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "luh-skin",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "README.md" }
      ]
    }
  }
}
