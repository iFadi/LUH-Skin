.idea/

# Transient build artifact created by update-skin.sh while compiling
LUH-Style/scss/*.compiled.scss

# Source map from a dev build (`./update-skin.sh dev`). Never commit it: prod builds
# are compiled with --no-source-map, and a map's "sources" are absolute build-host
# paths that leak the local layout and are meaningless on the server.
LUH-Style/LUH-Style.css.map
